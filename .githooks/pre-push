#!/usr/bin/env bash
# Tool-agnostic pre-push guard for gbcms. Fires for every pusher (human, Claude,
# Antigravity, …) once enabled: `git config core.hooksPath .githooks`.
#   1) Block direct pushes to main (Git Flow: main is updated via release PR only).
#   2) Scan for secrets with gitleaks before anything leaves the machine.
# Fail-open if gitleaks is not installed (warn, don't wedge pushes).
set -euo pipefail

# 1) Refuse direct push to main. stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
block_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push BLOCKED: direct push to main is prohibited (Git Flow: release PR only)." >&2
    block_main=1
  fi
done
[ "$block_main" = 1 ] && exit 1

# 2) Secret scan over tracked content (not the raw working tree, which would flag
#    gitignored never-pushed files). Scope to code AND fixtures — secrets hide there.
if command -v gitleaks >/dev/null 2>&1; then
  if ! out="$(gitleaks detect --no-banner --redact --exit-code 1 --source . 2>&1)"; then
    echo "pre-push BLOCKED: gitleaks found potential secrets before push:" >&2
    printf '%s\n' "$out" | tail -40 >&2
    echo "Remove the secret (and scrub history if already committed), or allowlist a false positive in .gitleaks.toml." >&2
    exit 1
  fi
else
  echo "pre-push: gitleaks not installed — secret scan skipped. Enable with: brew install gitleaks" >&2
fi

exit 0
