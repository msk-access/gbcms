#!/usr/bin/env bash
# Tool-agnostic commit guard for gbcms. Runs regardless of which agent (Claude,
# Antigravity, Cursor, Codex) or human drives the commit. Enable once per clone:
#   git config core.hooksPath .githooks
# Heavy checks (mypy, cargo test) stay in the qa-check skill / CI; this hook is fast.
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

# 1) Refuse to commit data/artifact files — except small synthetic fixtures under
#    tests/testdata/ (allowed by .gitignore), which must carry no real identifiers,
#    and the regression panel's checkpoint list (commit SHAs and PR labels, committed
#    on a checkpoint-wheels/* branch to build its wheels; checked in 1a).
#    Variant and read files carry patient or sample identifiers (a VCF's header and
#    #CHROM line name the sample; FASTQ read names carry run and flowcell IDs), so
#    VCF, BED and FASTQ are blocked too, plain or gzip/bgzip-compressed, in any case.
data_re='\.(parquet|bam|bai|cram|crai|tsv|csv|maf|dat|vcf|bed|fastq|fq)(\.(gz|bgz))?$'
checkpoints='scripts/regression_panel/checkpoints.tsv'
outside="$(printf '%s\n' "$staged" | grep -Ei "$data_re" | grep -v '^tests/testdata/' | grep -vxF "$checkpoints" || true)"
if [ -n "$outside" ]; then
  echo "pre-commit BLOCKED: data/artifact file staged. Unstage it (see .gitignore)." >&2
  printf '%s\n' "$outside" >&2
  exit 1
fi

# MSK sample IDs (P-0012345-T01-IH3), CMO/ACCESS IDs (C-ABC123-L001), and the
# anonymized DMP BAM stems (AB123456-T / -N).
id_re='P-[0-9]{7}-[TN][0-9]{2}-[A-Z]{2}[0-9]|C-[A-Z0-9]{6}-[LNT][0-9]{3}|(^|[^A-Za-z0-9])[A-Z]{2}[0-9]{6}-[TN]([^A-Za-z0-9]|$)'

# 1a) The checkpoint list must be what checkpoints.py writes: its header, then rows
#     whose sha column is a full commit SHA, and no sample identifier anywhere.
if printf '%s\n' "$staged" | grep -qxF "$checkpoints"; then
  if ! git show ":$checkpoints" | awk -F'\t' '
      NR == 1 { ok = ($0 == "order\tlabel\tsha\tinterval_merges"); next }
      NF != 4 || $3 !~ /^[0-9a-f]{40}$/ { ok = 0 }
      END { exit !(ok && NR > 1) }'; then
    echo "pre-commit BLOCKED: $checkpoints is not checkpoints.py output (header, then rows with a full commit SHA)." >&2
    exit 1
  fi
  if git show ":$checkpoints" | grep -Eq "$id_re"; then
    echo "pre-commit BLOCKED: $checkpoints holds what looks like a sample identifier." >&2
    exit 1
  fi
fi

# 1b) Every staged file under tests/testdata/ is scanned (the staged copy, decoded
#     where binary) for patient or sample identifiers, and kept small. Fixtures are
#     synthetic; real data never goes there. Fails closed when a file cannot be read.
fixtures="$(printf '%s\n' "$staged" | grep '^tests/testdata/' || true)"
if [ -n "$fixtures" ]; then
  max_bytes=2000000
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    size="$(git cat-file -s ":$f")"
    if [ "$size" -gt "$max_bytes" ]; then
      echo "pre-commit BLOCKED: $f is $size bytes; fixtures stay under $max_bytes (synthetic and small)." >&2
      exit 1
    fi
    # The decoder is picked by the lowercased name, so `X.VCF.GZ` is decoded like `x.vcf.gz`.
    case "$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')" in
      *.bam) text="$(git show ":$f" | gzip -dc 2>/dev/null | LC_ALL=C tr -c '[:print:]\n' ' ')" ;;
      # Compressed text (a .vcf.gz/.vcf.bgz header, .bed.gz, .fastq.gz): decode it so the
      # scan reads the header and read names, not compressed bytes it could never match.
      *.gz|*.bgz)
        text="$(git show ":$f" | gzip -dc | LC_ALL=C tr -c '[:print:]\n' ' ')" \
          || { echo "pre-commit BLOCKED: cannot decompress $f to scan it for identifiers." >&2; exit 1; }
        ;;
      *.parquet)
        text="$(git show ":$f" | python3 -c '
import io, sys
data = sys.stdin.buffer.read()
try:
    import polars as pl
    df = pl.read_parquet(io.BytesIO(data))
    print("\n".join(df.columns))
    for col in df.columns:
        print("\n".join(str(v) for v in df[col].to_list()))
except ImportError:
    import pyarrow.parquet as pq
    print(pq.read_table(io.BytesIO(data)).to_pydict())
')" || { echo "pre-commit BLOCKED: cannot read $f to scan it (needs python3 with polars or pyarrow)." >&2; exit 1; }
        ;;
      *) text="$(git show ":$f" | LC_ALL=C tr -c '[:print:]\n' ' ')" ;;
    esac
    if printf '%s\n' "$text" | grep -Eq "$id_re"; then
      echo "pre-commit BLOCKED: $f looks like it holds a real sample identifier:" >&2
      printf '%s\n' "$text" | grep -Eo "$id_re" | head -3 >&2
      echo "Fixtures must be synthetic. If this is a false positive, rename the value." >&2
      exit 1
    fi
  done <<< "$fixtures"
fi

# 2) Fast Python lint on staged source/test .py files (ruff + black --check).
# Scoped to src/ and tests/ — the lint gate is for the codebase, not harness
# scripts under .claude/ or .githooks/. Skip if none.
py="$(printf '%s\n' "$staged" | grep -E '^(src|tests)/.*\.py$' || true)"
if [ -n "$py" ]; then
  if command -v ruff >/dev/null 2>&1; then
    echo "$py" | xargs ruff check || { echo "pre-commit BLOCKED: ruff. Fix, then re-stage." >&2; exit 1; }
  fi
  if command -v black >/dev/null 2>&1; then
    echo "$py" | xargs black --check || { echo "pre-commit BLOCKED: black. Run 'black' then re-stage." >&2; exit 1; }
  fi
fi

# 3) Every staged skill's frontmatter must parse as YAML, checked on the staged copy
#    (check_skill_frontmatter.py: PyYAML when importable, else a minimal check). An
#    unquoted `#` or `: ` in a description truncates it or breaks the file, and the
#    skill's "use when" trigger never reaches the model.
skills="$(printf '%s\n' "$staged" | grep -E '^\.agents/skills/[^/]+/SKILL\.md$' || true)"
if [ -n "$skills" ]; then
  hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if ! git show ":$f" | python3 -I "$hooks_dir/check_skill_frontmatter.py" "$f"; then
      echo "pre-commit BLOCKED: $f frontmatter does not parse. Quote the description (double quotes)." >&2
      exit 1
    fi
  done <<< "$skills"
fi

# 3b) Every code name, flag and path a staged skill or rule mentions must exist
#     (scripts/check_agent_names.py; stdlib only). A renamed function or a deleted file
#     stays in the text agents trust until a check reads it. Skipped if the script is absent.
agent_docs="$(printf '%s\n' "$staged" | grep -E '^\.agents/(skills/[^/]+/SKILL\.md|rules/[^/]+\.md)$' || true)"
repo_root="$(git rev-parse --show-toplevel)"
if [ -n "$agent_docs" ] && [ -f "$repo_root/scripts/check_agent_names.py" ]; then
  if ! (cd "$repo_root" && printf '%s\n' "$agent_docs" | xargs python3 -I scripts/check_agent_names.py); then
    echo "pre-commit BLOCKED: a skill or rule names code, a flag or a file that does not exist (above). Fix the text, or EXTERNAL in scripts/check_agent_names.py if the name belongs to another tool." >&2
    exit 1
  fi
fi

exit 0
