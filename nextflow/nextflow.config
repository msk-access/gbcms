/*
========================================================================================
    gbcms Nextflow Configuration
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // Input options
    input                      = null
    variants                   = null
    fasta                      = null
    
    // Output options
    outdir                     = 'results'
    publish_dir_mode           = 'copy'
    format                     = 'vcf'
    suffix                     = ''
    column_prefix              = ''
    preserve_barcode           = false
    filter_by_sample           = false

    // Multi-BAM merge options (requires bam_type in samplesheet)
    merge_counts               = false        // Enable MERGE_COUNTS process
    merge_add_combined         = true         // Compute simplex_duplex_* combined columns
    merge_legacy_naming        = false        // Use t_{metric}_{type} naming (genotype_variants compat)
    
    // Quality & filtering
    min_mapq                   = 20         // DNA default (BWA: low MAPQ = poor alignment)
    rna_min_mapq               = 1          // RNA default — matches the `gbcms rna` CLI. STAR
                                            // encodes uniquely-mapped reads as MAPQ 255 but
                                            // 2–4-locus multi-mappers as MAPQ 3/1; a DNA-style
                                            // floor of 20 would silently drop those primaries
                                            // (~16% of reads genome-wide on a FORTE sample).
    min_baseq                  = 20
    fragment_qual_threshold    = 10
    context_padding            = 5
    filter_duplicates          = true
    filter_secondary           = true
    filter_supplementary       = true
    filter_qc_failed           = true
    filter_improper_pair       = false
    filter_indel               = false
    show_normalization         = false
    rescue_mnp                 = false
    rescue_mnp_threshold       = 1.0
    adaptive_context           = true
    
    // Mode (dna or rna)
    mode                       = 'dna'
    
    // UMI / BAQ
    // BAQ default: DNA CLI = off, RNA CLI = on.
    // The Nextflow modules handle this: DNA passes --apply-baq only if true,
    // RNA passes --no-baq only if false. Leave as false here (DNA default);
    // RNA mode relies on CLI default (on) unless user explicitly sets false.
    umi_tag                    = ''
    apply_baq                  = false
    
    // RNA-specific (only used with --mode rna)
    rna_editing_db             = ''
    gtf                        = ''
    gtf_cache                  = true        // M5a: pre-build the GTF index once per cohort (when --gtf set) so per-sample tasks skip the ~9s parse; set false to disable
    enforce_strandedness       = true
    strandedness               = 'reverse'   // 'reverse' (dUTP/-s2, FORTE default), 'forward' (-s1), 'unstranded' (-s0)
    library_type               = 'capture'   // P5: 'capture' (default) or 'amplicon'
    
    // Alignment backend (advanced)
    alignment_backend          = 'pairhmm'
    llr_threshold              = 2.3
    gap_open_prob              = 1e-4
    gap_extend_prob            = 0.1
    gap_open_prob_repeat       = 1e-2
    gap_extend_prob_repeat     = 0.5
    
    // mFSD options (DNA only)
    mfsd                       = false
    mfsd_parquet               = false
    mfsd_report                = false
    mfsd_report_min_alt        = 3
    mfsd_report_max_variants   = 20
    observations_parquet       = false
    
    // Max resource options
    max_cpus                   = 16
    max_memory                 = 128.GB
    max_time                   = 240.h
    
    // Boilerplate options
    tracedir                   = "${params.outdir}/pipeline_info"
    help                       = false
}

// Load base.config by default for all pipelines
process {
    cache  = 'lenient'  // GPFS/Spectrum Scale breaks default inode-based hashing on file migration; use name+size only
    cpus   = 1
    memory = 6.GB
    time   = 4.h
    shell  = ['/bin/bash', '-euo', 'pipefail']

    // Global resource ceiling. Nextflow-native replacement for the legacy
    // check_max() helper, which is illegal in the strict config syntax that is
    // the default from Nextflow 26.04. Every per-process `{ N * task.attempt }`
    // request below is automatically capped to these limits.
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]
    
    // Retry on OOM (137), SIGTERM (143), and unknown/null exit codes (SLURM kills)
    errorStrategy = { (task.exitStatus == null || task.exitStatus in [143,137,104,134,139,255]) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // SLURM job naming for readability in squeue output
    clusterOptions = { "--job-name=nf-${task.process.tokenize(':')[-1]}_${task.tag ?: task.hash}" }

    withName: 'GBCMS_DNA|GBCMS_RNA' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
        // Route to short queue on first attempt (faster scheduling),
        // escalate to cmobic_cpu (7-day limit) on retries
        queue  = { task.attempt > 1 ? 'cmobic_cpu' : 'cmobic_short' }
    }

    // Merge is I/O-bound (Polars in-memory join), not compute-heavy
    withName: 'MERGE_COUNTS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        queue  = 'cmobic_short'
    }

    // FILTER_MAF can OOM on large multi-sample MAFs
    withName: 'FILTER_MAF' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
        queue  = 'cmobic_short'
    }

    // Summary is a trivial aggregation step
    withName: 'PIPELINE_SUMMARY' {
        cpus   = 1
        memory = 2.GB
        time   = 30.min
        queue  = 'cmobic_short'
    }
}

// Executor Configuration
executor {
    queueSize = 100  // Max concurrent SLURM jobs
}

profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '--platform linux/amd64 --entrypoint=""'
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'cmobic_cpu'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Local development profile (no container, reduced resources for parallelism)
    local {
        docker.enabled         = false
        singularity.enabled    = false
        
        // Disable trace - macOS without container lacks ps for metrics
        trace.enabled          = false
        
        process {
            cpus   = 4
            memory = 8.GB
            time   = 24.h
        }
    }
    
    // IRIS HPC profile (self-contained — no longer depends on the removed
    // nf-core institutional-config include). Sets a valid SLURM queue directly;
    // a bare 'cpu' queue is rejected on IRIS. Note: withName blocks above provide
    // per-process dynamic queue routing (cmobic_short → cmobic_cpu); this sets the
    // fallback for any process without an explicit queue directive.
    iris {
        process {
            executor       = 'slurm'
            queue          = 'cmobic_cpu'
            cache          = 'lenient'
        }
        singularity {
            enabled    = true
            autoMounts = true
        }
        docker.enabled = false
    }
}

// NOTE: the remote nf-core institutional-config include (previously a
// try/catch-guarded `includeConfig` of nf-core/configs) was removed. The strict
// config syntax of Nextflow ≥26.04 forbids both try/catch and if-guards at the
// config top level, so a fetch failure could no longer be made non-fatal. Our
// HPC profiles (iris, slurm) are defined locally above and need no remote config.
// Users who want an institutional config can still supply one with `-c`.

// Execution reports for monitoring
trace {
    enabled = true
    file = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    file = "${params.tracedir}/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.tracedir}/pipeline_dag.svg"
    overwrite = true
}

// (The legacy check_max() helper was removed. Function definitions are illegal
// in the strict config syntax of Nextflow ≥26.04; the `process.resourceLimits`
// directive above is the Nextflow-native replacement.)

manifest {
    name            = 'msk-access/gbcms'
    author          = 'MSK-ACCESS Team'
    homePage        = 'https://github.com/msk-access/gbcms'
    description     = 'High-performance variant counting from BAM files'
    mainScript      = 'main.nf'
    // resourceLimits (used above) requires Nextflow ≥24.04; the strict config
    // syntax it targets is the default from 26.04. This code parses under both
    // the 25.x legacy parser and the ≥26.04 strict parser.
    nextflowVersion = '!>=24.04.0'
    version         = '6.1.0'
}
