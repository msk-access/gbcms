/*
========================================================================================
    gbcms Nextflow Configuration
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // Input options
    input                      = null
    variants                   = null
    fasta                      = null
    
    // Output options
    outdir                     = 'results'
    publish_dir_mode           = 'copy'
    format                     = 'vcf'
    suffix                     = ''
    column_prefix              = ''
    preserve_barcode           = false
    filter_by_sample           = false

    // Multi-BAM merge options (requires bam_type in samplesheet)
    merge_counts               = false        // Enable MERGE_COUNTS process
    merge_add_combined         = true         // Compute simplex_duplex_* combined columns
    merge_legacy_naming        = false        // Use t_{metric}_{type} naming (genotype_variants compat)
    
    // Quality & filtering
    min_mapq                   = 20
    min_baseq                  = 20
    fragment_qual_threshold    = 10
    context_padding            = 5
    filter_duplicates          = true
    filter_secondary           = true
    filter_supplementary       = true
    filter_qc_failed           = true
    filter_improper_pair       = false
    filter_indel               = false
    show_normalization         = false
    rescue_mnp                 = false
    rescue_mnp_threshold       = 1.0
    adaptive_context           = true
    
    // Mode (dna or rna)
    mode                       = 'dna'
    
    // UMI / BAQ
    // BAQ default: DNA CLI = off, RNA CLI = on.
    // The Nextflow modules handle this: DNA passes --apply-baq only if true,
    // RNA passes --no-baq only if false. Leave as false here (DNA default);
    // RNA mode relies on CLI default (on) unless user explicitly sets false.
    umi_tag                    = ''
    apply_baq                  = false
    
    // RNA-specific (only used with --mode rna)
    rna_editing_db             = ''
    gtf                        = ''
    enforce_strandedness       = true
    library_type               = 'capture'   // P5: 'capture' (default) or 'amplicon'
    
    // Alignment backend (advanced)
    alignment_backend          = 'pairhmm'
    llr_threshold              = 2.3
    gap_open_prob              = 1e-4
    gap_extend_prob            = 0.1
    gap_open_prob_repeat       = 1e-2
    gap_extend_prob_repeat     = 0.5
    
    // mFSD options (DNA only)
    mfsd                       = false
    mfsd_parquet               = false
    mfsd_report                = false
    mfsd_report_min_alt        = 3
    mfsd_report_max_variants   = 20
    
    // Max resource options
    max_cpus                   = 16
    max_memory                 = 128.GB
    max_time                   = 240.h
    
    // Boilerplate options
    tracedir                   = "${params.outdir}/pipeline_info"
    help                       = false
    // nf-core institutional config support
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

// Load base.config by default for all pipelines
process {
    cache  = 'lenient'  // GPFS/Spectrum Scale breaks default inode-based hashing on file migration; use name+size only
    cpus   = 1
    memory = 6.GB
    time   = 4.h
    shell  = ['/bin/bash', '-euo', 'pipefail']
    
    errorStrategy = { task.exitStatus in [143,137,104,134,139,255] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // SLURM job naming for readability in squeue output
    clusterOptions = { "--job-name=nf-${task.process.tokenize(':')[-1]}_${task.tag ?: task.hash}" }

    withName: 'GBCMS_DNA|GBCMS_RNA' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    // Merge is I/O-bound (Polars in-memory join), not compute-heavy
    withName: 'MERGE_COUNTS' {
        cpus   = 1
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }
}

// Executor Configuration
executor {
    queueSize = 100  // Max concurrent SLURM jobs
}

profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '--platform linux/amd64 --entrypoint=""'
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'cmobic_cpu'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Local development profile (no container, reduced resources for parallelism)
    local {
        docker.enabled         = false
        singularity.enabled    = false
        
        // Disable trace - macOS without container lacks ps for metrics
        trace.enabled          = false
        
        process {
            cpus   = 4
            memory = 8.GB
            time   = 24.h
        }
    }
    
    // IRIS HPC profile override
    iris {
        // Override nf-core iris institutional config default ('cpu') which causes rejection
        params.partition = 'cmobic_cpu'
        
        process {
            executor       = 'slurm'
            cache          = 'lenient'
        }
        singularity {
            enabled    = true
            autoMounts = true
        }
        docker.enabled = false
    }
}

// Load nf-core institutional configs (e.g. iris, jax, sanger, etc.)
// See: https://github.com/nf-core/configs
try {
    includeConfig "${params.custom_config_base}/nfcore_custom.config"
} catch (Exception e) {
    System.err.println("WARNING: Could not load nf-core/configs — institutional profiles unavailable")
}

// Execution reports for monitoring
trace {
    enabled = true
    file = "${params.tracedir}/execution_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    file = "${params.tracedir}/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.tracedir}/pipeline_dag.svg"
    overwrite = true
}

// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

manifest {
    name            = 'msk-access/gbcms'
    author          = 'MSK-ACCESS Team'
    homePage        = 'https://github.com/msk-access/gbcms'
    description     = 'High-performance variant counting from BAM files'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    version         = '5.3.0'
}
